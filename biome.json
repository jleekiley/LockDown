{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!assets"],
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "off",
        "useHookAtTopLevel": "error",
        "useExhaustiveDependencies": "warn"
      },
      "suspicious": {
        "noDoubleEquals": {
          "level": "warn",
          "options": {
            "ignoreNull": true
          }
        },
        "noVar": "error",
        "noDuplicateParameters": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateCase": "error",
        "noRedeclare": "warn",
        "noExtraNonNullAssertion": "warn",
        "noArrayIndexKey": "warn"
      },
      "complexity": {
        "noBannedTypes": "warn",
        "noUselessConstructor": "warn",
        "useFlatMap": "warn",
        "useOptionalChain": "warn"
      },
      "style": {
        "useConsistentArrayType": {
          "level": "warn",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useConst": "warn",
        "useImportType": "warn",
        "noCommonJs": "off"
      },
      "security": {
        "noBlankTarget": "off",
        "noDangerouslySetInnerHtml": "warn"
      },
      "performance": {
        "noDelete": "warn"
      }
    }
  },
  "javascript": {
    "jsxRuntime": "transparent",
    "formatter": {
      "quoteStyle": "double"
    },
    "globals": [
      "__DEV__",
      "ErrorUtils",
      "FormData",
      "XMLHttpRequest",
      "alert",
      "cancelAnimationFrame",
      "cancelIdleCallback",
      "clearImmediate",
      "fetch",
      "navigator",
      "process",
      "requestAnimationFrame",
      "requestIdleCallback",
      "setImmediate",
      "window"
    ]
  },
  "overrides": [
    {
      "includes": ["*.config.js", "*.config.ts", "metro.config.*"],
      "javascript": {
        "globals": ["__dirname", "__filename", "require", "module", "exports"]
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
